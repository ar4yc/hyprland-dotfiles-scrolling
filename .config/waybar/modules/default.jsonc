{
 "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
      "active":  "",
      "default": ""
    }
 },

 "custom/cpu": {
    "exec": "sensors | awk '/temp1:/ {print +$2; exit}'",
    "interval": 1,
    "format": " {}°C",
    "tooltip": false
  },

  "custom/gpu": {
    "exec": "echo  $(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader)°C",
    "interval": 1,
    "format": "{}",
    "tooltip": false
  },

  "cpu": {
    "format": "<span color=\"#ced9ed\"></span>  {usage}%  ",
    "interval": 1
  },

  "memory": {
    "format": "<span color=\"#ced9ed\"></span>   {percentage}% ",
    "interval": 1
  },

  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/waybar_cava.sh",
    "restart-interval": 1,
    "hide-empty": true,
    "on-click": "kitty --class cava sh -c cava"
  },

  "clock#simple": {
    "format": "{:%H:%M:%S}",
    "tooltip": false
  },

  "clock": {
    "format": "{:L%d %b, %a}",
    "tooltip": false
  },

  "custom/swaync": { 
    "format": "{icon}",
    "format-icons": {
      "newnotify": " ",
      "default": " "
    },
    "on-click": "swaync-client -t -sw"
  },
  
  "custom/mpris-scroll": {
    "exec": "zscroll -l 35 -d 0.2 --update-interval 1 -e true --match-command 'playerctl status 2>/dev/null' --match-text 'Playing' '--scroll 1' --match-text 'Paused' '--scroll 1' --update-check true \"playerctl metadata --format '{{ title }}' 2>/dev/null\"",
    "format": "  {}",
    "on-click": "playerctl play-pause",
    "escape": true
  },
  
  "bluetooth": {
    "format": "{}", 
    "format-on": "",
    "format-off": "󰂲",
    "format-no-controler": "",
    "format-disabled": "󰂲",
    "format-connected": "{device_alias}",
    "format-connected-battery": "{device_alias}   {device_battery_percentage}%",
    "tooltip-format": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)"
  },

  "network": {
    "format": "{essid}",
    "format-wifi": "<span color=\"#ced9ed\"></span>",
    "format-ethernet": "<span color=\"#ced9ed\"></span>",
    "format-disconnected": "<span color=\"#ced9ed\"></span>",
    "tooltip-format": "{essid}, {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "{essid}Disconnected",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio#output": {
    "format": "{icon}   {volume}%",
    "format-muted": "   {volume}%",
    "format-icons": {
      "default": ["","","","","", "","","","",""]
    },
    "tooltip-format": "{desc} - {volume}%",
    "on-click-right": "pavucontrol-qt -t 3",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"
  },

  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "  {volume}%",
    "tooltip-format": "{source_desc} - {volume}%",
    "on-click-right": "pavucontrol-qt -t 4",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 10%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 10%-"
  },

  "hyprland/language": {
    "format": "<span color=\"#ced9ed\"></span>  {}",
    "format-en": "EN",
    "format-ru": "RU",
    "keyboard-name": "sonix-usb-device",
    "tooltip": false,
    "on-click": "hyprctl switchxkblayout all next"
  },

  "tray": {
    "spacing": 7,
    "swap-icon-label": true
  },
  
  "custom/gamemode": { 
    "format": "{icon}",
    "format-icons": {
    "default": [""]
    },
    "on-click": "hyprctl eval $(cat $HOME/.config/hypr/scripts/gamemode.lua)",
    "tooltip": false
  },

  "custom/clipboard": { 
    "format": "{icon}",
    "format-icons": {
    "default": [""]
    },
    "on-click": "cliphist list | rofi -dmenu | cliphist decode | wl-copy && wtype -M ctrl -P v -m ctrl",
    "tooltip": false
  },

  "custom/noscreenshare": {
   "exec": "~/.config/waybar/scripts/toggle_noscreenshare.sh",
   "on-click": "~/.config/waybar/scripts/toggle_noscreenshare.sh toggle && pkill -SIGRTMIN+4 waybar",
   "signal": 4,
   "interval": "once",
   "return-type": "json",
   "tooltip": false,
   "format": "{icon}",
   "format-icons": {
     "off": "󱙝",
     "on": "󰗹"
    }
  },

  "custom/power": {
   "interval": "once",
   "format": "⏻ ",
   "on-click": "wlogout --margin-top 400 --margin-bottom 400 --margin-left 750 --margin-right 750",
   "tooltip": false
  }
}
